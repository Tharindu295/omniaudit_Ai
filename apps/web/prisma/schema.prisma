datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model AuditLog {
  id               String   @id @default(cuid())
  documentId       String
  filename         String
  riskScore        Int
  status           String
  findingsCount    Int
  processingTimeMs Int
  findings         Json?    // Findings array eka JSON widihata database eke thiyaganna
  createdAt        DateTime @default(now())
}